PORT=4000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=serene_spa
PGUSER=postgres
PGPASSWORD=postgres

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# CORS - who's allowed to call this API. Comma-separated: the staff portal
# and the public website run as two separate apps/domains now, so both need
# to be listed (the public website doesn't use sockets, but it does call the
# regular REST API, so it needs to be here too).
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001

# Bootstrap admin account (created automatically by the seed script)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@serenespa.com
ADMIN_PASSWORD=ChangeMe123!

# Business rules (all in minutes)
PENDING_TIMEOUT_MINUTES=30
ENDING_SOON_LEAD_MINUTES=10
TIMER_CHECK_INTERVAL_SECONDS=20
